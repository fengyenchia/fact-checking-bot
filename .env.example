# For local development, copy this file to .env.local beside package.json.
# Fill in the real values in .env.local. On Vercel, enter each value in Project Settings.

# Neon Console > Connect > pooled connection string for the initialized branch.
DATABASE_URL=

# API key for the OpenAI Project used by the demo.
OPENAI_API_KEY=

# Set this to the password you want to use for /admin/login.
ADMIN_PASSWORD=

# Private signing secret for admin sessions. Generate a separate value per environment:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# Optional override for generated replies and case metadata. Defaults to gpt-6-luna.
# URL web search uses gpt-6-luna independently.
# OPENAI_MODEL=gpt-6-luna
